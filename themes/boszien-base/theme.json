{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1370px"
    },
    "color": {
      "defaultPalette": false,
      "custom": false,
      "customGradients": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "background", "name": "Boszien achtergrond", "color": "#f5f7f2" },
        { "slug": "surface", "name": "Boszien wit", "color": "#ffffff" },
        { "slug": "text-primary", "name": "Boszien tekst", "color": "#102b25" },
        { "slug": "text-muted", "name": "Boszien gedempt", "color": "#526a63" },
        { "slug": "deep", "name": "Boszien nachtbos", "color": "#051410" },
        { "slug": "deep-text", "name": "Tekst op nachtbos", "color": "#dcebe5" },
        { "slug": "accent", "name": "Boszien mint", "color": "#7ce6bd" },
        { "slug": "accent-strong", "name": "Boszien sterk mint", "color": "#0d8d72" },
        { "slug": "soft", "name": "Boszien grijsgroen", "color": "#e5ece5" },
        { "slug": "sand", "name": "Boszien zand", "color": "#efe3c3" },
        { "slug": "warning", "name": "Boszien goud", "color": "#d8b55f" }
      ],
      "gradients": []
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw", "vh"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "name": "2X Small", "size": "0.5rem" },
        { "slug": "30", "name": "X Small", "size": "0.875rem" },
        { "slug": "40", "name": "Small", "size": "clamp(1rem, 1.2vw, 1.25rem)" },
        { "slug": "50", "name": "Medium", "size": "clamp(1.5rem, 2.4vw, 2rem)" },
        { "slug": "60", "name": "Large", "size": "clamp(2.25rem, 4vw, 3.5rem)" },
        { "slug": "70", "name": "X Large", "size": "clamp(3.75rem, 7vw, 6.5rem)" }
      ],
      "blockGap": true
    },
    "typography": {
      "fluid": true,
      "customFontSize": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        { "slug": "inter", "name": "Inter", "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" },
        { "slug": "poppins", "name": "Poppins", "fontFamily": "Poppins, Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" }
      ],
      "fontSizes": [
        { "slug": "x-small", "name": "X Small", "size": "clamp(0.76rem, 0.74rem + 0.1vw, 0.82rem)" },
        { "slug": "small", "name": "Small", "size": "clamp(0.9rem, 0.87rem + 0.15vw, 0.98rem)" },
        { "slug": "medium", "name": "Medium", "size": "clamp(1rem, 0.96rem + 0.2vw, 1.1rem)" },
        { "slug": "large", "name": "Large", "size": "clamp(1.2rem, 1.08rem + 0.55vw, 1.5rem)" },
        { "slug": "x-large", "name": "X Large", "size": "clamp(1.75rem, 1.45rem + 1.35vw, 2.55rem)" },
        { "slug": "huge", "name": "Huge", "size": "clamp(2.55rem, 1.85rem + 3.1vw, 4.7rem)" }
      ]
    },
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "shadow": { "defaultPresets": false, "presets": [] },
    "custom": {
      "color": { "border": "rgba(16, 43, 37, 0.16)", "border-dark": "rgba(220, 235, 229, 0.2)" },
      "layout": { "shell": "1180px", "reading": "760px", "editorial": "1370px" },
      "radius": { "sm": "0.25rem", "md": "0.5rem", "lg": "0.75rem", "pill": "999px" }
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "var:preset|spacing|40",
      "padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" }
    },
    "color": { "background": "var:preset|color|background", "text": "var:preset|color|text-primary" },
    "typography": {
      "fontFamily": "var:preset|font-family|inter",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "450",
      "lineHeight": "1.62"
    },
    "elements": {
      "heading": {
        "typography": { "fontFamily": "var:preset|font-family|poppins", "fontWeight": "800", "lineHeight": "1.08" },
        "color": { "text": "var:preset|color|text-primary" }
      },
      "h1": {
        "typography": { "fontSize": "var:preset|font-size|huge", "fontWeight": "800", "lineHeight": "0.98", "letterSpacing": "-0.05em" },
        "spacing": { "margin": { "top": "0", "bottom": "var:preset|spacing|40" } }
      },
      "h2": { "typography": { "fontSize": "var:preset|font-size|x-large", "fontWeight": "800", "lineHeight": "1.08", "letterSpacing": "-0.035em" } },
      "h3": { "typography": { "fontSize": "var:preset|font-size|large", "fontWeight": "750", "lineHeight": "1.18", "letterSpacing": "-0.018em" } },
      "link": { "color": { "text": "var:preset|color|deep" }, "typography": { "textDecoration": "underline" } },
      "button": {
        "border": { "radius": "var(--wp--custom--radius--pill)" },
        "color": { "background": "var:preset|color|deep", "text": "var:preset|color|deep-text" },
        "spacing": { "padding": { "top": "0.82rem", "right": "1.15rem", "bottom": "0.82rem", "left": "1.15rem" } },
        "typography": { "fontFamily": "var:preset|font-family|poppins", "fontSize": "var:preset|font-size|small", "fontWeight": "700", "lineHeight": "1.2" }
      }
    },
    "blocks": {
      "core/navigation": { "typography": { "fontFamily": "var:preset|font-family|poppins", "fontSize": "var:preset|font-size|small", "fontWeight": "650" } },
      "core/search": { "border": { "radius": "var(--wp--custom--radius--md)" } },
      "core/group": { "spacing": { "blockGap": "var:preset|spacing|40" } },
      "core/paragraph": { "spacing": { "margin": { "top": "0", "bottom": "1em" } } },
      "core/post-content": { "spacing": { "blockGap": "var:preset|spacing|40" } }
    }
  },
  "customTemplates": [
    { "name": "page-plain", "title": "Boszien landingpage zonder automatische titel", "postTypes": ["page"] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
